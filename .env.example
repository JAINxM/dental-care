# ===============================================
# Supabase PostgreSQL Database Configuration
# ===============================================
# From Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use Session mode (port 5432) or Transaction mode (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Session Secret (random string of 32+ characters)
SESSION_SECRET=a_very_secret_random_key_replace_this_with_your_own_secret_key_32chars

# Frontend Origin URL (for CORS and CSRF protection)
# Local development:
CLIENT_URL=http://localhost:5173
# For Vercel production deployment:
# CLIENT_URL=https://your-clinic-app.vercel.app

# Doctor Account Provisioning (for npm run db:seed)
DOCTOR_EMAIL=doctor@dermacare.com
DOCTOR_PASSWORD=DoctorSecurePassword123!
DOCTOR_NAME=Dr. Priya Sharma

# ===============================================
# Optional n8n & WhatsApp Automation Settings
# ===============================================
# N8N_BOOKING_WEBHOOK=https://your-n8n-instance/webhook/booking
# N8N_CANCEL_WEBHOOK=https://your-n8n-instance/webhook/cancel
# N8N_BACKEND_TOKEN=your_backend_secret_token

